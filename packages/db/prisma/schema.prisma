generator client {
  provider = "prisma-client"
  output = "../src/generated"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  OWNER
  ADMIN
  EDITOR
  APPROVER
  CLIENT_VIEWER
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  memberships Membership[]
  oauthDiscoveryConsumptions OAuthDiscoveryConsumption[]
  publicationSchedules PublicationSchedule[]
  renderJobs RenderJob[]
}
model Session {
  id String @id
  token String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model RateLimit {
  id String @id
  key String @unique
  count Int
  lastRequest BigInt
}
model Organization {
  id String @id @default(uuid())
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  clients Client[]
  memberships Membership[]
  brands Brand[]
  mediaAssets MediaAsset[]
  contentBatches ContentBatch[]
  posts Post[]
  socialAccounts SocialAccount[]
  publicationAttempts PublicationAttempt[]
  oauthDiscoveryConsumptions OAuthDiscoveryConsumption[]
  publicationSchedules PublicationSchedule[]
  designTemplates DesignTemplate[]
  designTemplateVersions DesignTemplateVersion[]
  renderJobs RenderJob[]
}
model Client {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  name String
  slug String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  memberships Membership[]
  brands Brand[]
  mediaAssets MediaAsset[]
  contentBatches ContentBatch[]
  posts Post[]
  socialAccounts SocialAccount[]
  publicationAttempts PublicationAttempt[]
  oauthDiscoveryConsumptions OAuthDiscoveryConsumption[]
  publicationSchedules PublicationSchedule[]
  designTemplates DesignTemplate[]
  designTemplateVersions DesignTemplateVersion[]
  renderJobs RenderJob[]
  @@unique([organizationId, slug])
  @@unique([organizationId, id])
}
model Membership {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  clientId String?
  client Client? @relation(fields: [organizationId, clientId], references: [organizationId, id])
  role Role
  active Boolean @default(true)
  @@unique([userId, organizationId, clientId])
  @@index([userId, organizationId])
}
model Brand {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  clientId String
  client Client @relation(fields: [organizationId, clientId], references: [organizationId, id])
  name String
  description String?
  targetAudience String?
  toneOfVoice String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId, id])
  mediaAssets MediaAsset[]
  posts Post[]
  @@unique([organizationId, clientId, id])
  @@index([organizationId, clientId])
}
model MediaAsset {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  clientId String
  client Client @relation(fields: [organizationId, clientId], references: [organizationId, id])
  brandId String?
  brand Brand? @relation(fields: [organizationId, clientId, brandId], references: [organizationId, clientId, id])
  name String
  description String @default("")
  storageKey String @unique
  status String @default("pending")
  mimeType String?
  byteSize Int?
  width Int?
  height Int?
  sha256 String?
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publicationSchedules PublicationSchedule[]
  backgroundRenderJobs RenderJob[] @relation("RenderBackgroundMedia")
  logoRenderJobs       RenderJob[] @relation("RenderLogoMedia")
  outputRenderJobs     RenderJob[] @relation("RenderOutputMedia")
  @@unique([organizationId, id])
  @@unique([organizationId, clientId, id])
  @@index([organizationId, clientId, createdAt, id])
}

model AuditLog {
  id String @id @default(uuid())
  organizationId String
  actorUserId String
  action String
  entityId String
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
}

enum BatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PostStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

model ContentBatch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String
  client         Client       @relation(fields: [organizationId, clientId], references: [organizationId, id])
  name           String
  sourceType     String       @default("CSV")
  status         BatchStatus  @default(PENDING)
  totalRows      Int          @default(0)
  validRows      Int          @default(0)
  invalidRows    Int          @default(0)
  errorReport    Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  posts          Post[]

  @@unique([organizationId, id])
  @@unique([organizationId, clientId, id])
  @@index([organizationId, clientId, createdAt])
}

model Post {
  id                  String               @id @default(uuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id])
  clientId            String
  client              Client               @relation(fields: [organizationId, clientId], references: [organizationId, id])
  batchId             String?
  batch               ContentBatch?        @relation(fields: [organizationId, clientId, batchId], references: [organizationId, clientId, id], onDelete: Restrict)
  brandId             String?
  brand               Brand?               @relation(fields: [organizationId, clientId, brandId], references: [organizationId, clientId, id], onDelete: Restrict)
  status              PostStatus           @default(DRAFT)
  title               String?
  caption             String
  hashtags            String?
  callToAction        String?
  firstComment        String?
  suggestedDate       DateTime?
  rejectionReason     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  publicationAttempts PublicationAttempt[]
  schedules           PublicationSchedule[]
  renderJobs          RenderJob[]

  @@unique([organizationId, id])
  @@unique([organizationId, clientId, id])
  @@index([organizationId, clientId, status, createdAt])
  @@index([organizationId, clientId, batchId])
}

enum SocialPlatform {
  FACEBOOK_PAGE
  INSTAGRAM_BUSINESS
}

enum SocialAccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
  DISCONNECTED
}

enum PublicationAttemptStatus {
  PENDING
  PROCESSING
  CONTAINER_CREATED
  PUBLISHED
  FAILED
  UNCERTAIN
}

model SocialAccount {
  id                  String               @id @default(uuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id])
  clientId            String
  client              Client               @relation(fields: [organizationId, clientId], references: [organizationId, id])
  platform            SocialPlatform
  platformAccountId    String
  name                String
  username            String?
  avatarUrl           String?
  status              SocialAccountStatus  @default(ACTIVE)
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  credential          OAuthCredential?
  publicationAttempts PublicationAttempt[]

  @@unique([organizationId, id])
  @@unique([organizationId, clientId, id])
  @@unique([organizationId, clientId, platform, platformAccountId])
  @@index([organizationId, clientId, status])
}

model OAuthCredential {
  id                   String        @id @default(uuid())
  socialAccountId       String        @unique
  socialAccount        SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  encryptedAccessToken String
  iv                   String
  authTag              String
  keyVersion           Int           @default(1)
  tokenType            String        @default("PAGE_ACCESS_TOKEN")
  scopes               String[]      @default([])
  expiresAt            DateTime?
  lastRefreshedAt      DateTime      @default(now())
  reconnectReason      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model PublicationAttempt {
  id                  String                   @id @default(uuid())
  organizationId      String
  organization        Organization             @relation(fields: [organizationId], references: [id])
  clientId            String
  client              Client                   @relation(fields: [organizationId, clientId], references: [organizationId, id])
  postId              String
  post                Post                     @relation(fields: [organizationId, clientId, postId], references: [organizationId, clientId, id], onDelete: Cascade)
  socialAccountId      String
  socialAccount       SocialAccount            @relation(fields: [organizationId, clientId, socialAccountId], references: [organizationId, clientId, id], onDelete: Cascade)
  status              PublicationAttemptStatus @default(PENDING)
  creationContainerId String?
  remoteMediaId       String?
  remotePermalink     String?
  errorCode           String?
  errorMessage        String?
  attemptNumber       Int                      @default(1)
  executedAt          DateTime                 @default(now())
  leaseExpiresAt      DateTime?
  scheduleId          String?
  schedule            PublicationSchedule?     @relation(fields: [organizationId, clientId, scheduleId], references: [organizationId, clientId, id], onDelete: SetNull)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, clientId, id])
  @@index([organizationId, clientId, status, executedAt])
  @@index([postId, socialAccountId])
  @@index([creationContainerId])
  @@index([status, leaseExpiresAt])
  @@index([organizationId, clientId, scheduleId])
}

model OAuthDiscoveryConsumption {
  id                  String       @id @default(uuid())
  discoveryId         String       @unique
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  clientId            String
  client              Client       @relation(fields: [organizationId, clientId], references: [organizationId, id])
  userId              String
  user                User         @relation(fields: [userId], references: [id])
  consumedAt          DateTime     @default(now())
  selectedAssets      Json
  connectedAccountIds String[]

  @@unique([organizationId, discoveryId])
  @@unique([organizationId, clientId, discoveryId])
  @@index([organizationId, clientId, discoveryId])
}

enum PublicationScheduleStatus {
  SCHEDULED
  ENQUEUED
  PROCESSING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  CANCELLED
  DEAD_LETTER
  REQUIRES_RECONCILIATION
}

model PublicationSchedule {
  id                 String                    @id @default(uuid())
  organizationId     String
  organization       Organization              @relation(fields: [organizationId], references: [id])
  clientId           String
  client             Client                    @relation(fields: [organizationId, clientId], references: [organizationId, id])
  postId             String
  post               Post                      @relation(fields: [organizationId, clientId, postId], references: [organizationId, clientId, id], onDelete: Cascade)
  targetAccountIds   String[]
  mediaAssetId       String?
  mediaAsset         MediaAsset?               @relation(fields: [organizationId, mediaAssetId], references: [organizationId, id], onDelete: SetNull)
  scheduledTimezone  String
  scheduledLocalTime String
  scheduledForUtc    DateTime
  status             PublicationScheduleStatus @default(SCHEDULED)
  version            Int                       @default(1)
  jobId              String
  createdById        String
  createdBy          User                      @relation(fields: [createdById], references: [id])
  executionToken     String?
  leaseExpiresAt     DateTime?
  attemptsMade       Int                       @default(0)
  cancellationReason String?
  failureReason      String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  publicationAttempts PublicationAttempt[]

  @@unique([organizationId, id])
  @@unique([organizationId, clientId, id])
  @@index([organizationId, clientId, status, scheduledForUtc])
  @@index([postId, status])
  @@index([jobId])
  @@index([status, leaseExpiresAt])
}

enum DesignFormat {
  SQUARE
  PORTRAIT
  STORY
}

enum DesignTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum RenderJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model DesignTemplate {
  id             String                  @id @default(uuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id])
  clientId       String
  client         Client                  @relation(fields: [organizationId, clientId], references: [organizationId, id])
  name           String
  systemKey      String?
  status         DesignTemplateStatus    @default(ACTIVE)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  versions       DesignTemplateVersion[]

  @@unique([organizationId, id])
  @@unique([organizationId, clientId, id])
  @@unique([organizationId, clientId, systemKey])
  @@index([organizationId, clientId, status, createdAt])
}

model DesignTemplateVersion {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  clientId        String
  client          Client         @relation(fields: [organizationId, clientId], references: [organizationId, id])
  templateId      String
  template        DesignTemplate @relation(fields: [organizationId, clientId, templateId], references: [organizationId, clientId, id], onDelete: Cascade)
  version         Int
  format          DesignFormat
  spec            Json
  specHash        String
  rendererVersion String
  createdAt       DateTime       @default(now())
  renderJobs      RenderJob[]

  @@unique([organizationId, id])
  @@unique([organizationId, clientId, id])
  @@unique([templateId, version])
  @@index([organizationId, clientId, templateId, version])
}

model RenderJob {
  id                 String                @id @default(uuid())
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id])
  clientId           String
  client             Client                @relation(fields: [organizationId, clientId], references: [organizationId, id])
  templateVersionId  String
  templateVersion    DesignTemplateVersion @relation(fields: [organizationId, clientId, templateVersionId], references: [organizationId, clientId, id], onDelete: Restrict)
  postId             String?
  post               Post?                 @relation(fields: [organizationId, clientId, postId], references: [organizationId, clientId, id], onDelete: Restrict)
  backgroundMediaAssetId String?
  backgroundMediaAsset   MediaAsset?           @relation("RenderBackgroundMedia", fields: [organizationId, clientId, backgroundMediaAssetId], references: [organizationId, clientId, id], onDelete: Restrict)
  logoMediaAssetId       String?
  logoMediaAsset         MediaAsset?           @relation("RenderLogoMedia", fields: [organizationId, clientId, logoMediaAssetId], references: [organizationId, clientId, id], onDelete: Restrict)
  outputMediaAssetId String?               @unique
  outputMediaAsset   MediaAsset?           @relation("RenderOutputMedia", fields: [organizationId, clientId, outputMediaAssetId], references: [organizationId, clientId, id], onDelete: Restrict)
  status             RenderJobStatus       @default(PENDING)
  input              Json
  inputHash          String
  idempotencyKey     String
  createdById        String
  createdBy          User                  @relation(fields: [createdById], references: [id])
  queueJobId         String?               @unique
  executionToken     String?
  attemptNumber      Int                   @default(0)
  leaseExpiresAt     DateTime?
  errorCode          String?
  errorMessage       String?
  completedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, clientId, id])
  @@unique([organizationId, clientId, idempotencyKey])
  @@index([organizationId, clientId, status, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([templateVersionId])
  @@index([postId])
  @@index([backgroundMediaAssetId])
  @@index([logoMediaAssetId])
}

