generator client {
  provider = "prisma-client"
  output = "../src/generated"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  OWNER
  ADMIN
  EDITOR
  APPROVER
  CLIENT_VIEWER
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  memberships Membership[]
}
model Session {
  id String @id
  token String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model RateLimit {
  id String @id
  key String @unique
  count Int
  lastRequest BigInt
}
model Organization {
  id String @id @default(uuid())
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  clients Client[]
  memberships Membership[]
  brands Brand[]
  mediaAssets MediaAsset[]
  contentBatches ContentBatch[]
  posts Post[]
  socialAccounts SocialAccount[]
  publicationAttempts PublicationAttempt[]
}
model Client {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  name String
  slug String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  memberships Membership[]
  brands Brand[]
  mediaAssets MediaAsset[]
  contentBatches ContentBatch[]
  posts Post[]
  socialAccounts SocialAccount[]
  publicationAttempts PublicationAttempt[]
  @@unique([organizationId, slug])
  @@unique([organizationId, id])
}
model Membership {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  clientId String?
  client Client? @relation(fields: [organizationId, clientId], references: [organizationId, id])
  role Role
  active Boolean @default(true)
  @@unique([userId, organizationId, clientId])
  @@index([userId, organizationId])
}
model Brand {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  clientId String
  client Client @relation(fields: [organizationId, clientId], references: [organizationId, id])
  name String
  description String?
  targetAudience String?
  toneOfVoice String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId, id])
  mediaAssets MediaAsset[]
  posts Post[]
  @@unique([organizationId, clientId, id])
  @@index([organizationId, clientId])
}
model MediaAsset {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  clientId String
  client Client @relation(fields: [organizationId, clientId], references: [organizationId, id])
  brandId String?
  brand Brand? @relation(fields: [organizationId, clientId, brandId], references: [organizationId, clientId, id])
  name String
  description String @default("")
  storageKey String @unique
  status String @default("pending")
  mimeType String?
  byteSize Int?
  width Int?
  height Int?
  sha256 String?
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId, id])
  @@index([organizationId, clientId, createdAt, id])
}

model AuditLog {
  id String @id @default(uuid())
  organizationId String
  actorUserId String
  action String
  entityId String
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
}

enum BatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PostStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

model ContentBatch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String
  client         Client       @relation(fields: [organizationId, clientId], references: [organizationId, id])
  name           String
  sourceType     String       @default("CSV")
  status         BatchStatus  @default(PENDING)
  totalRows      Int          @default(0)
  validRows      Int          @default(0)
  invalidRows    Int          @default(0)
  errorReport    Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  posts          Post[]

  @@unique([organizationId, id])
  @@unique([organizationId, clientId, id])
  @@index([organizationId, clientId, createdAt])
}

model Post {
  id                  String               @id @default(uuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id])
  clientId            String
  client              Client               @relation(fields: [organizationId, clientId], references: [organizationId, id])
  batchId             String?
  batch               ContentBatch?        @relation(fields: [organizationId, clientId, batchId], references: [organizationId, clientId, id], onDelete: Restrict)
  brandId             String?
  brand               Brand?               @relation(fields: [organizationId, clientId, brandId], references: [organizationId, clientId, id], onDelete: Restrict)
  status              PostStatus           @default(DRAFT)
  title               String?
  caption             String
  hashtags            String?
  callToAction        String?
  firstComment        String?
  suggestedDate       DateTime?
  rejectionReason     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  publicationAttempts PublicationAttempt[]

  @@unique([organizationId, id])
  @@unique([organizationId, clientId, id])
  @@index([organizationId, clientId, status, createdAt])
  @@index([organizationId, clientId, batchId])
}

enum SocialPlatform {
  FACEBOOK_PAGE
  INSTAGRAM_BUSINESS
}

enum SocialAccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
  DISCONNECTED
}

enum PublicationAttemptStatus {
  PENDING
  CONTAINER_CREATED
  PUBLISHED
  FAILED
}

model SocialAccount {
  id                  String               @id @default(uuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id])
  clientId            String
  client              Client               @relation(fields: [organizationId, clientId], references: [organizationId, id])
  platform            SocialPlatform
  platformAccountId    String
  name                String
  username            String?
  avatarUrl           String?
  status              SocialAccountStatus  @default(ACTIVE)
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  credential          OAuthCredential?
  publicationAttempts PublicationAttempt[]

  @@unique([organizationId, id])
  @@unique([organizationId, clientId, id])
  @@unique([organizationId, clientId, platform, platformAccountId])
  @@index([organizationId, clientId, status])
}

model OAuthCredential {
  id                   String        @id @default(uuid())
  socialAccountId       String        @unique
  socialAccount        SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  encryptedAccessToken String
  iv                   String
  authTag              String
  keyVersion           Int           @default(1)
  tokenType            String        @default("PAGE_ACCESS_TOKEN")
  scopes               String[]      @default([])
  expiresAt            DateTime?
  lastRefreshedAt      DateTime      @default(now())
  reconnectReason      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model PublicationAttempt {
  id                  String                   @id @default(uuid())
  organizationId      String
  organization        Organization             @relation(fields: [organizationId], references: [id])
  clientId            String
  client              Client                   @relation(fields: [organizationId, clientId], references: [organizationId, id])
  postId              String
  post                Post                     @relation(fields: [organizationId, clientId, postId], references: [organizationId, clientId, id], onDelete: Cascade)
  socialAccountId      String
  socialAccount       SocialAccount            @relation(fields: [organizationId, clientId, socialAccountId], references: [organizationId, clientId, id], onDelete: Cascade)
  status              PublicationAttemptStatus @default(PENDING)
  creationContainerId String?
  remoteMediaId       String?
  remotePermalink     String?
  errorCode           String?
  errorMessage        String?
  attemptNumber       Int                      @default(1)
  executedAt          DateTime                 @default(now())
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, clientId, id])
  @@index([organizationId, clientId, status, executedAt])
  @@index([postId, socialAccountId])
  @@index([creationContainerId])
}

